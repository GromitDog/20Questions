@page "/Answerer"

<PageTitle>20 Questions - Answerer</PageTitle>

<RadzenText TextStyle="TextStyle.H1">20 Questions</RadzenText>

@if (_errorMessages.Any())
{
    // display error message(s)
    <RadzenCard class="rz-background-color-danger rz-shadow-0 rz-border-radius-0 rz-p-8">
        <RadzenColumn SizeSM="4">
            @foreach(var error in _errorMessages)
            {
                <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-danger">
                    @error
                </RadzenText>
            }
        </RadzenColumn>
    </RadzenCard>
}

@if (_game is null)
{
    // Start Game Form
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">



        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Answer</RadzenText>
            <RadzenTextBox @bind-Value="@_characterName" Style="width: 100%" aria-label="Default TextBox"/>
        </RadzenCard>

        <RadzenButton Click="@(_ => StartGame())" Text="Start Game" ButtonStyle="ButtonStyle.Primary" disabled="@(!CanStart)"/>

    </RadzenStack>
}


@if (_game is not null)
{
    <RadzenCard Variant="Variant.Flat">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H5">
                <h5>Game Started!</h5>
            </RadzenText>
            <RadzenText TextStyle="TextStyle.H5">
                <strong>Game ID:</strong> @_game.Id
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                Share this ID with the questioner to join your game.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
    
    <RadzenCard>
        <RadzenText>Answer questions about: @_characterName</RadzenText>
        
        <RadzenChat Title="Game Questions and Answers" 
                    CurrentUserId="@AnswererId"
                    Users="@Users"
                    Messages="@Messages"
                    Placeholder=@(_waitingForQuestion ? "Please answer one of the following:" : "Wait for a question...")
                    ShowClearButton="@false"
                    ShowUserNames="true"
                    ReadOnly="true"
        />
        
        @if (_waitingForQuestion)
        {
            <RadzenText>Waiting for question...</RadzenText>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Click="AnswerYes">Yes</RadzenButton>
                <RadzenButton Click="AnswerNo">No</RadzenButton>
                <RadzenButton Click="AnswerDontKnow">I don't know</RadzenButton>
            </RadzenStack>
        }

    </RadzenCard>
}