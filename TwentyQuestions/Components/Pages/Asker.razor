@page "/Asker"
<PageTitle>20 Questions - Asker</PageTitle>

<RadzenText TextStyle="TextStyle.H1">20 Questions</RadzenText>

@if (_errorMessages.Any())
{
    // display error message(s)
    <RadzenCard class="rz-background-color-danger rz-shadow-0 rz-border-radius-0 rz-p-8">
        <RadzenColumn SizeSM="4">
            @foreach (var error in _errorMessages)
            {
                <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-danger">
                    @error
                </RadzenText>
            }
        </RadzenColumn>
    </RadzenCard>
}

@if (_game is not null)
{
    <RadzenCard Variant="Variant.Flat">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H5">
                <h5>Game Started!</h5>
            </RadzenText>
            <RadzenText TextStyle="TextStyle.H5">
                <strong>Game ID:</strong> @_game.Id
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                Share this ID with the questioner to join your game.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenText>Ask yes/no questions to find out who the character is</RadzenText>

        <RadzenChat Title="Game Questions and Answers"
                    CurrentUserId="@AskerId"
                    Users="@Users"
                    Messages="@Messages"
                    MessagesChanged="@OnQuestionSent"
                    Placeholder=@(_waitingForAnswer ? "Waiting for an answer to the last question..." : "What do you want to ask?")
                    ShowClearButton="@false"
                    ShowUserNames="true"
                    ReadOnly="@_waitingForAnswer"/>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" style="margin-top: 1rem;">
            <RadzenButton Click="GiveUp" ButtonStyle="ButtonStyle.Danger">Give Up</RadzenButton>
        </RadzenStack>

    </RadzenCard>
}